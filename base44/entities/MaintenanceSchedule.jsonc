{
  "name": "MaintenanceSchedule",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string",
      "title": "Ve\u00edculo",
      "relatedEntity": "Vehicle"
    },
    "name": {
      "type": "string",
      "title": "Nome da Manuten\u00e7\u00e3o"
    },
    "interval_km": {
      "type": "number",
      "title": "Intervalo (km)"
    },
    "interval_months": {
      "type": "number",
      "title": "Intervalo (meses)"
    },
    "warning_km": {
      "type": "number",
      "title": "Aviso antecipado (km)",
      "default": 500
    },
    "last_done_km": {
      "type": "number",
      "title": "\u00daltima realiza\u00e7\u00e3o (km)"
    },
    "last_done_date": {
      "type": "string",
      "format": "date",
      "title": "\u00daltima realiza\u00e7\u00e3o (data)"
    },
    "is_active": {
      "type": "boolean",
      "title": "Ativo",
      "default": true
    }
  },
  "required": [
    "vehicle_id",
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}